---
import Icon from './Icon.astro';
import type { Service } from '../data/site';

interface Props {
  service: Service;
  index?: number;
}
const { service, index = 0 } = Astro.props;
---
<a
  href={`/services/${service.slug}`}
  data-reveal
  style={`--reveal-delay:${(index % 3) * 90}ms`}
  class="group relative flex flex-col overflow-hidden rounded-2xl border border-navy-100 bg-white p-7 shadow-[0_1px_2px_rgba(7,18,40,0.04)] transition duration-300 hover:-translate-y-1 hover:border-red-200 hover:shadow-[0_24px_50px_-24px_rgba(15,134,127,0.35)]"
>
  <div
    class="mb-6 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-navy-50 text-red-600 transition-colors duration-300 group-hover:bg-red-600 group-hover:text-white"
  >
    <Icon name={service.icon} size={24} />
  </div>

  <h3 class="font-display text-lg font-semibold text-navy-800">
    {service.title}
  </h3>
  <p class="mt-2.5 flex-1 text-sm leading-relaxed text-navy-500">
    {service.summary}
  </p>

  <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-red-600">
    Learn more
    <Icon
      name="arrowRight"
      size={16}
      class="transition-transform duration-300 group-hover:translate-x-1"
    />
  </span>

  <!-- accent hairline -->
  <span
    class="pointer-events-none absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-0 bg-gradient-to-r from-red-500 to-navy-600 transition-transform duration-300 group-hover:scale-x-100"
    aria-hidden="true"
  ></span>
</a>
