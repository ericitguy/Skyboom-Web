---
import Button from './Button.astro';
import Icon from './Icon.astro';
import NetworkMotif from './NetworkMotif.astro';
import { nap } from '../data/site';

interface Props {
  heading?: string;
  body?: string;
}
const {
  heading = 'Ready to build reliable telecom infrastructure?',
  body = 'Talk to Skyboom about your next network, fibre or data-centre project in Ghana. Share your scope and our engineers will help you plan the build.',
} = Astro.props;
---
<section class="relative overflow-hidden bg-navy-800 py-20 lg:py-24">
  <div class="pointer-events-none absolute inset-0 opacity-20" aria-hidden="true">
    <NetworkMotif />
  </div>
  <div
    class="pointer-events-none absolute -right-24 top-1/2 h-96 w-96 -translate-y-1/2 rounded-full bg-red-500/20 blur-3xl"
    aria-hidden="true"
  ></div>

  <div class="container-page relative">
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <p class="eyebrow justify-center text-red-300">Let's talk</p>
      <h2 class="mt-4 font-display text-3xl font-bold text-white sm:text-4xl">
        {heading}
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-navy-100">
        {body}
      </p>
      <div class="mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <Button href="/contact" variant="primary" size="lg">Start a project</Button>
        <a
          href={`tel:${nap.phoneE164}`}
          class="inline-flex items-center gap-2.5 text-base font-semibold text-white transition hover:text-red-300"
        >
          <Icon name="phone" size={18} />
          {nap.phoneDisplay}
        </a>
      </div>
    </div>
  </div>
</section>
