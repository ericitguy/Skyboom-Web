---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import ServiceCard from '../components/ServiceCard.astro';
import NetworkMotif from '../components/NetworkMotif.astro';
import FAQ from '../components/FAQ.astro';
import CTASection from '../components/CTASection.astro';
import { services, differentiators, stats, faqs } from '../data/site';
import { faqSchema } from '../lib/schema';
import heroGrid from '../assets/hero-grid.png';
import fibreGlow from '../assets/fibre-glow.png';

const seo = {
  title: 'Skyboom Ghana | Telecom Infrastructure Company in Tema',
  description:
    'Skyboom Ghana Limited is a 100% Ghanaian-owned telecom infrastructure company in Tema. We deliver network deployment, fibre optics, FTTH and data-centre builds across Ghana.',
  path: '/',
};
---
<BaseLayout {...seo} schemas={[faqSchema(faqs)]}>
  <!-- ================= HERO ================= -->
  <section class="relative isolate overflow-hidden bg-navy-900 pt-20">
    <!-- Backdrop image + motion overlay -->
    <div class="absolute inset-0 -z-10">
      <Image
        src={heroGrid}
        alt="Abstract fibre-optic network mesh representing Ghana's telecom infrastructure"
        class="h-full w-full object-cover opacity-70"
        widths={[768, 1280, 1600]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-navy-900/70 via-navy-900/80 to-navy-900"></div>
      <div class="absolute inset-0 opacity-60" aria-hidden="true"><NetworkMotif /></div>
    </div>

    <div class="container-page relative flex min-h-[88vh] flex-col justify-center py-24">
      <div class="max-w-3xl">
        <p class="eyebrow text-red-300" data-reveal>
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-red-300"></span>
          100% Ghanaian-owned · Established 2017 · Tema
        </p>
        <h1
          class="mt-6 font-display text-4xl font-bold leading-[1.05] text-white sm:text-5xl lg:text-6xl xl:text-7xl"
          data-reveal
          style="--reveal-delay:80ms"
        >
          Telecom infrastructure
          <span class="block bg-gradient-to-r from-red-300 to-red-500 bg-clip-text text-transparent">
            built to last.
          </span>
        </h1>
        <p
          class="mt-7 max-w-2xl text-lg leading-relaxed text-navy-100 sm:text-xl"
          data-reveal
          style="--reveal-delay:160ms"
        >
          Skyboom Ghana Limited designs, builds and maintains the networks that
          connect Ghana and West Africa — from fibre optics and FTTH to microwave
          transmission, civil works and data centres. Delivered with precision,
          safety and engineering integrity.
        </p>
        <div class="mt-10 flex flex-col gap-4 sm:flex-row" data-reveal style="--reveal-delay:240ms">
          <Button href="/contact" variant="primary" size="lg">Start a project</Button>
          <Button href="/services" variant="outline-light" size="lg" icon="arrowRight">
            Explore our services
          </Button>
        </div>

        <!-- Trust strip -->
        <dl
          class="mt-16 grid max-w-2xl grid-cols-2 gap-x-8 gap-y-6 border-t border-white/10 pt-8 sm:grid-cols-4"
          data-reveal
          style="--reveal-delay:320ms"
        >
          {
            stats.map((s) => (
              <div>
                <dd class="font-display text-3xl font-bold text-white sm:text-4xl">
                  <span
                    data-count={s.value}
                    data-prefix={s.prefix ?? ''}
                    data-suffix={s.suffix ?? ''}
                  >
                    {s.prefix ?? ''}0{s.suffix ?? ''}
                  </span>
                </dd>
                <dt class="mt-1 text-xs font-medium uppercase tracking-wider text-navy-200">
                  {s.label}
                </dt>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- ================= WHO WE ARE ================= -->
  <section class="py-24 lg:py-28">
    <div class="container-page grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
      <div data-reveal>
        <div class="relative overflow-hidden rounded-3xl border border-navy-100 shadow-xl">
          <Image
            src={fibreGlow}
            alt="Fibre-optic strands carrying light, symbolising Skyboom's high-capacity network builds in Ghana"
            class="h-full w-full object-cover"
            widths={[600, 900, 1400]}
            sizes="(min-width: 1024px) 45vw, 100vw"
          />
        </div>
      </div>

      <div>
        <p class="eyebrow" data-reveal>Who we are</p>
        <h2 class="mt-4 font-display text-3xl font-bold text-navy-800 sm:text-4xl" data-reveal>
          A Ghanaian telecom engineering partner you can build on
        </h2>
        <div class="mt-6 space-y-5 text-lg leading-relaxed text-navy-500" data-reveal style="--reveal-delay:80ms">
          <p>
            Founded in Tema in 2017, Skyboom Ghana Limited is a 100% Ghanaian-owned
            telecom services provider. We build the infrastructure that carries voice,
            data and connectivity across Ghana and the wider West African region —
            with an uncompromising focus on quality, safety and efficiency.
          </p>
          <p>
            From greenfield network rollouts to fibre optics, FTTH, microwave links,
            civil works and data-centre design, our teams combine international
            engineering standards with deep local knowledge of Ghanaian ground,
            climate and grid conditions.
          </p>
        </div>

        <ul class="mt-8 grid gap-4 sm:grid-cols-2" data-reveal style="--reveal-delay:160ms">
          {
            [
              'Turnkey delivery across nine service lines',
              'Experience with leading global manufacturers',
              'Capacity to partner-finance projects',
              'Embedded Health & Safety culture',
            ].map((point) => (
              <li class="flex items-start gap-3">
                <Icon name="checkCircle" size={22} class="mt-0.5 shrink-0 text-red-500" />
                <span class="text-navy-700">{point}</span>
              </li>
            ))
          }
        </ul>

        <div class="mt-9" data-reveal style="--reveal-delay:220ms">
          <Button href="/about" variant="secondary">More about Skyboom</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= SERVICES ================= -->
  <section id="services" class="bg-navy-50/60 py-24 lg:py-28">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow justify-center" data-reveal>What we do</p>
        <h2 class="mt-4 font-display text-3xl font-bold text-navy-800 sm:text-4xl" data-reveal>
          End-to-end telecom infrastructure services
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-navy-500" data-reveal style="--reveal-delay:80ms">
          Nine specialised service lines that take a network from the ground up —
          design, build, connect and maintain — anywhere in Ghana.
        </p>
      </div>

      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((service, i) => <ServiceCard service={service} index={i} />)}
      </div>
    </div>
  </section>

  <!-- ================= WHY SKYBOOM ================= -->
  <section class="py-24 lg:py-28">
    <div class="container-page">
      <div class="grid gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
        <div>
          <p class="eyebrow" data-reveal>Why Skyboom</p>
          <h2 class="mt-4 font-display text-3xl font-bold text-navy-800 sm:text-4xl" data-reveal>
            The advantages that de-risk your project
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-navy-500" data-reveal style="--reveal-delay:80ms">
            Clients across Ghana choose Skyboom because we combine technical depth
            with financial strength and a genuine safety-first culture — the
            foundations of infrastructure that performs for years.
          </p>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          {
            differentiators.map((d, i) => (
              <div
                data-reveal
                style={`--reveal-delay:${(i % 2) * 90}ms`}
                class="rounded-2xl border border-navy-100 bg-white p-6 transition hover:border-red-200 hover:shadow-lg"
              >
                <div class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-red-400/15 text-red-600">
                  <Icon name={d.icon} size={22} />
                </div>
                <h3 class="mt-5 font-display text-lg font-semibold text-navy-800">{d.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-navy-500">{d.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ================= HEALTH & SAFETY ================= -->
  <section id="health-safety" class="relative overflow-hidden bg-navy-900 py-24 text-white lg:py-28">
    <div class="pointer-events-none absolute inset-0 opacity-25" aria-hidden="true"><NetworkMotif /></div>
    <div
      class="pointer-events-none absolute -left-32 top-0 h-96 w-96 rounded-full bg-red-500/10 blur-3xl"
      aria-hidden="true"
    ></div>

    <div class="container-page relative grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
      <div>
        <p class="eyebrow text-red-400" data-reveal>
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-red-400"></span>
          Health &amp; Safety
        </p>
        <h2 class="mt-4 font-display text-3xl font-bold sm:text-4xl" data-reveal>
          Everyone goes home safe. Every site, every day.
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-navy-100" data-reveal style="--reveal-delay:80ms">
          Telecom infrastructure work involves height, power and heavy plant.
          At Skyboom, Health &amp; Safety isn't a checklist — it's embedded in how
          we plan, build and maintain. A strong HSE culture protects our crews,
          your assets and the Ghanaian communities we work in, and it's central
          to the quality of everything we deliver.
        </p>

        <div class="mt-8" data-reveal style="--reveal-delay:160ms">
          <Button href="/about" variant="outline-light">Our commitment to safety</Button>
        </div>
      </div>

      <ul class="grid gap-4 sm:grid-cols-2" data-reveal style="--reveal-delay:120ms">
        {
          [
            { icon: 'hardhat', t: 'Safety-led method statements', d: 'Every task planned and risk-assessed before work begins.' },
            { icon: 'shield', t: 'Working at height & live power', d: 'Trained crews and correct PPE for high-risk environments.' },
            { icon: 'checkCircle', t: 'Quality assurance', d: 'Structured QA and sign-off at every project milestone.' },
            { icon: 'users', t: 'Community awareness', d: 'Minimal disruption and respect for the sites we build in.' },
          ].map((c) => (
            <li class="rounded-2xl border border-white/10 bg-white/[0.04] p-6 backdrop-blur-sm">
              <div class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-red-400/15 text-red-300">
                <Icon name={c.icon} size={22} />
              </div>
              <h3 class="mt-4 font-display text-base font-semibold text-white">{c.t}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-navy-200">{c.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ================= FAQ ================= -->
  <section id="faq" class="py-24 lg:py-28">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow justify-center" data-reveal>Answers</p>
        <h2 class="mt-4 font-display text-3xl font-bold text-navy-800 sm:text-4xl" data-reveal>
          Frequently asked questions
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-navy-500" data-reveal style="--reveal-delay:80ms">
          Common questions about working with Skyboom Ghana Limited on telecom
          infrastructure projects.
        </p>
      </div>
      <div class="mt-12" data-reveal>
        <FAQ />
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
