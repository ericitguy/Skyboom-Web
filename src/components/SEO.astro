---
/**
 * Reusable SEO head component.
 *
 * Owns every per-page meta tag: unique title + description, canonical link,
 * Open Graph, Twitter Card, and any page-specific JSON-LD passed in via the
 * `schemas` prop. Sitewide LocalBusiness schema lives in BaseLayout.
 */
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Path only, e.g. "/services/fibre-optics-installation". Canonical is built from site.url. */
  path: string;
  /** Absolute-from-root image path; defaults to the site OG image. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Any number of JSON-LD objects to inject (Service, BreadcrumbList, FAQPage…). */
  schemas?: Record<string, unknown>[];
}

const {
  title,
  description,
  path,
  image = site.ogImage,
  imageAlt = `${site.name} — telecom infrastructure services in Ghana`,
  type = 'website',
  noindex = false,
  schemas = [],
} = Astro.props;

// Normalise to a trailing-slash-free canonical to match trailingSlash:'never'
// and the sitemap output (root collapses to the bare origin).
const canonical = new URL(path, site.url).href.replace(/\/+$/, '') || site.url;
const ogImageUrl = new URL(image, site.url).href;
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{
  noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
  )
}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content="en_GH" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

{
  schemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))
}
