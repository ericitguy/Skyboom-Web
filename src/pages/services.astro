---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ServiceCard from '../components/ServiceCard.astro';
import NetworkMotif from '../components/NetworkMotif.astro';
import FAQ from '../components/FAQ.astro';
import CTASection from '../components/CTASection.astro';
import { services, faqs } from '../data/site';
import { breadcrumbSchema, faqSchema } from '../lib/schema';

const seo = {
  title: 'Telecom Infrastructure Services in Ghana | Skyboom',
  description:
    'Explore Skyboom Ghana Limited’s telecom services — network deployment, equipment installation, fibre optics, FTTH, microwave transmission, civil works, data centres and support.',
  path: '/services',
};

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
];
---
<BaseLayout {...seo} schemas={[breadcrumbSchema(crumbs), faqSchema(faqs)]}>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden bg-navy-900 pt-20 text-white">
    <div class="absolute inset-0 -z-10 opacity-50" aria-hidden="true"><NetworkMotif /></div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-navy-900/40 to-navy-900"></div>
    <div class="pointer-events-none absolute -right-24 -top-16 -z-10 h-96 w-96 rounded-full bg-red-600/20 blur-3xl" aria-hidden="true"></div>

    <div class="container-page py-20 lg:py-24">
      <div data-reveal><Breadcrumbs crumbs={crumbs} /></div>
      <div class="mt-8 max-w-3xl">
        <p class="eyebrow text-red-300" data-reveal>
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-red-400"></span>
          What we do
        </p>
        <h1 class="mt-5 font-display text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl" data-reveal style="--reveal-delay:60ms">
          Telecom infrastructure services
          <span class="bg-gradient-to-r from-red-400 to-red-600 bg-clip-text text-transparent"> across Ghana</span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-navy-100 sm:text-xl" data-reveal style="--reveal-delay:140ms">
          Nine specialised, individually-engineered service lines — everything
          needed to design, build, connect and maintain resilient networks in
          Ghana and across West Africa.
        </p>
      </div>
    </div>
  </section>

  <!-- Services grid -->
  <section class="py-20 lg:py-24">
    <div class="container-page">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((service, i) => <ServiceCard service={service} index={i} />)}
      </div>
    </div>
  </section>

  <!-- Process band -->
  <section class="border-y border-navy-100 bg-navy-50/60 py-20 lg:py-24">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow justify-center" data-reveal>How we deliver</p>
        <h2 class="mt-4 font-display text-3xl font-bold text-navy-800 sm:text-4xl" data-reveal>
          A disciplined delivery process
        </h2>
      </div>
      <ol class="mt-14 grid gap-8 md:grid-cols-4">
        {
          [
            { n: '01', t: 'Survey & Design', d: 'Site surveys and design validation to match RF, fibre and civil plans before build.' },
            { n: '02', t: 'Build & Install', d: 'Coordinated civil, power and telecom crews delivering to OEM and operator standards.' },
            { n: '03', t: 'Test & Commission', d: 'Structured testing, integration and acceptance so every asset meets its KPIs.' },
            { n: '04', t: 'Maintain & Support', d: 'SLA-backed preventive and corrective maintenance that protects your investment.' },
          ].map((step, i) => (
            <li data-reveal style={`--reveal-delay:${i * 80}ms`} class="relative">
              <span class="font-display text-4xl font-bold text-red-400/80">{step.n}</span>
              <h3 class="mt-3 font-display text-lg font-semibold text-navy-800">{step.t}</h3>
              <p class="mt-2 text-sm leading-relaxed text-navy-500">{step.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 lg:py-24">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow justify-center" data-reveal>Answers</p>
        <h2 class="mt-4 font-display text-3xl font-bold text-navy-800 sm:text-4xl" data-reveal>
          Service &amp; project FAQs
        </h2>
      </div>
      <div class="mt-12" data-reveal><FAQ /></div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
