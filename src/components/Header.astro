---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nap } from '../data/site';

const nav = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? current === '/' : current === href || current.startsWith(href + '/');
---
<header
  id="site-header"
  class="site-header fixed inset-x-0 top-0 z-50 transition-[background-color,box-shadow,border-color] duration-300"
>
  <div class="container-page">
    <div class="flex h-20 items-center justify-between">
      <a href="/" class="header-logo shrink-0" aria-label="Skyboom Ghana Limited — home">
        <span class="logo-chip"><Logo class="h-12" /></span>
      </a>

      <nav class="hidden items-center gap-8 lg:flex" aria-label="Primary">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class="nav-link link-underline text-sm font-medium"
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="hidden items-center gap-4 lg:flex">
        <a
          href={`tel:${nap.phoneE164}`}
          class="nav-link flex items-center gap-2 text-sm font-medium"
        >
          <Icon name="phone" size={16} />
          <span>{nap.phoneDisplay}</span>
        </a>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 rounded-full bg-red-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-red-700 hover:shadow-md focus-visible:outline-offset-4"
        >
          Contact Us
          <Icon name="arrowRight" size={16} />
        </a>
      </div>

      <button
        id="menu-toggle"
        type="button"
        class="nav-link -mr-2 inline-flex items-center justify-center rounded-lg p-2 lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="menu-open"><Icon name="menu" size={26} /></span>
        <span class="menu-close hidden"><Icon name="x" size={26} /></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    data-open="false"
    class="mobile-menu lg:hidden"
  >
    <nav class="container-page flex flex-col gap-1 py-6" aria-label="Mobile">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="rounded-lg px-3 py-3 font-display text-lg font-medium text-navy-800 transition hover:bg-navy-50"
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={`tel:${nap.phoneE164}`}
        class="mt-2 flex items-center gap-2 rounded-lg px-3 py-3 text-navy-600"
      >
        <Icon name="phone" size={18} />
        {nap.phoneDisplay}
      </a>
      <a
        href="/contact"
        class="mt-2 inline-flex items-center justify-center gap-2 rounded-full bg-red-600 px-5 py-3.5 text-base font-semibold text-white"
      >
        Contact Us
        <Icon name="arrowRight" size={18} />
      </a>
    </nav>
  </div>
</header>

<style>
  /* Transparent over the hero, solid once scrolled. Default (top) = over dark hero. */
  .site-header {
    background-color: transparent;
    border-bottom: 1px solid transparent;
  }
  .site-header.is-scrolled {
    background-color: rgba(255, 255, 255, 0.9);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom-color: rgba(12, 27, 61, 0.08);
    box-shadow: 0 8px 30px -12px rgba(7, 18, 40, 0.18);
  }

  /* Nav link colours: white over hero, navy when scrolled */
  .nav-link {
    color: rgba(255, 255, 255, 0.85);
  }
  .nav-link:hover {
    color: #ffffff;
  }
  .site-header.is-scrolled .nav-link {
    color: #132650;
  }
  .site-header.is-scrolled .nav-link:hover {
    color: #cf1c1f;
  }
  .nav-link[aria-current='page'] {
    color: #ffffff;
  }
  .site-header.is-scrolled .nav-link[aria-current='page'] {
    color: #cf1c1f;
  }

  /* Logo backing chip: white over the dark hero (keeps the dark wordmark
     legible), transparent once the header turns solid white on scroll. */
  .header-logo {
    display: inline-flex;
  }
  .logo-chip {
    display: inline-flex;
    align-items: center;
    background: #ffffff;
    padding: 6px 12px;
    border-radius: 12px;
    transition: background-color 0.3s ease, padding 0.3s ease;
  }
  .site-header.is-scrolled .logo-chip {
    background: transparent;
    padding: 6px 0;
  }

  /* Mobile menu panel */
  .mobile-menu {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    background: #ffffff;
    border-bottom: 1px solid rgba(12, 27, 61, 0.08);
    box-shadow: 0 24px 40px -20px rgba(7, 18, 40, 0.35);
    transform-origin: top;
    transform: scaleY(0);
    opacity: 0;
    visibility: hidden;
    transition:
      transform 0.28s var(--ease-out-expo),
      opacity 0.2s ease,
      visibility 0.28s;
  }
  .mobile-menu[data-open='true'] {
    transform: scaleY(1);
    opacity: 1;
    visibility: visible;
  }

  #menu-toggle[aria-expanded='true'] .menu-open {
    display: none;
  }
  #menu-toggle[aria-expanded='true'] .menu-close {
    display: inline-flex;
  }

  /* When the mobile menu is open, force the toggle icon dark for contrast */
  @media (max-width: 1023px) {
    #menu-toggle[aria-expanded='true'] {
      color: #132650;
    }
  }
</style>
