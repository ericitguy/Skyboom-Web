---
import Icon from './Icon.astro';
import { faqs } from '../data/site';
---
<div class="mx-auto max-w-3xl divide-y divide-navy-100 rounded-2xl border border-navy-100 bg-white">
  {
    faqs.map((item, i) => (
      <details class="group" name="faq" open={i === 0}>
        <summary
          class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 font-display text-base font-semibold text-navy-800 transition hover:text-red-600 [&::-webkit-details-marker]:hidden"
        >
          <span>{item.q}</span>
          <Icon
            name="chevronDown"
            size={20}
            class="shrink-0 text-red-500 transition-transform duration-300 group-open:rotate-180"
          />
        </summary>
        <div class="px-6 pb-6 pt-0 text-[0.95rem] leading-relaxed text-navy-500">
          {item.a}
        </div>
      </details>
    ))
  }
</div>
